{
  "name": "huagao-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for HuaGao WebService (WebSocket-based document scanning/image processing API)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "huagao",
    "scanner",
    "document-scanning",
    "image-processing",
    "websocket"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/",
    "src/"
  ]
}
